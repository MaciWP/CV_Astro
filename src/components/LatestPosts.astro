---
/**
 * Latest blog posts on the language homes: the strongest crawled pages link
 * straight to the newest posts, so Google reaches them without the navbar.
 * No data-reveal on purpose: the block sits below the fold and must never
 * shift layout or start hidden. Renders nothing when the language has no posts.
 * @file src/components/LatestPosts.astro
 */
import { getCollection } from 'astro:content';
import SvgIcons from './icons/SvgIcons.astro';
import { localizedPosts, slugFromId, blogUrl } from '../utils/blog';
import { DATE_LOCALE, normalizeLang } from '../i18n';

interface Props {
  lang: string;
  title: string;
  allLabel: string;
}
const { lang, title, allLabel } = Astro.props;

const posts = localizedPosts(await getCollection('blog'), lang).slice(0, 2);
const blogIndex = lang === 'en' ? '/blog' : `/${lang}/blog`;
const fmt = new Intl.DateTimeFormat(DATE_LOCALE[normalizeLang(lang)], {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

{
  posts.length > 0 && (
    <section id="latest-posts" aria-labelledby="latest-posts-title">
      <div class="flex items-center mb-6 section-header">
        <div class="w-10 h-10 flex items-center justify-center bg-brand-red text-white rounded-none section-icon">
          <SvgIcons name="file-alt" class="w-4 h-4" />
        </div>
        <h2 id="latest-posts-title" class="text-2xl font-bold ml-3">{title}</h2>
      </div>

      <ul class="space-y-6">
        {posts.map((post) => (
          <li>
            <article class="group">
              <a href={blogUrl(lang, slugFromId(post.id))} class="block no-underline">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-lg font-bold tracking-tight transition-colors duration-150 group-hover:text-brand-red">
                    {post.data.title}
                  </h3>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="shrink-0 text-sm text-light-text-secondary dark:text-dark-text-secondary"
                  >
                    {fmt.format(post.data.pubDate)}
                  </time>
                </div>
                <p class="mt-1 text-light-text-secondary dark:text-dark-text-secondary">
                  {post.data.description}
                </p>
              </a>
            </article>
          </li>
        ))}
      </ul>

      <p class="mt-4">
        <a href={blogIndex} class="text-brand-red hover:underline font-semibold">{allLabel}</a>
      </p>
    </section>
  )
}
