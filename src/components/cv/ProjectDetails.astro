---
/**
 * A project card's long description and key features, server-rendered inside
 * an inert <template>: it adds nothing to the live DOM until "Show all details"
 * clones it in (see the Projects script).
 * @file src/components/cv/ProjectDetails.astro
 */
import SvgIcons from '../icons/SvgIcons.astro';

interface Props {
    longDescription: string;
    features?: string[];
    featuresLabel: string;
}

const { longDescription, features = [], featuresLabel } = Astro.props;
---

<div class="expandable-content hidden">
    <template>
        <p class="long-description mb-4 text-light-text-secondary dark:text-dark-text-secondary">{longDescription}</p>
        {features.length > 0 && (
            <div class="key-features mb-4">
                <h4 class="text-sm uppercase text-brand-red font-semibold mb-2 tracking-wider">{featuresLabel}</h4>
                <ul class="space-y-2 text-sm">
                    {features.map((feature) => (
                        <li class="flex items-start gap-2">
                            <span class="text-brand-red shrink-0 mt-1"><SvgIcons name="check" class="w-3 h-3" /></span>
                            <span>{feature}</span>
                        </li>
                    ))}
                </ul>
            </div>
        )}
    </template>
</div>
