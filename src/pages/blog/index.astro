---
/**
 * Blog index (English, default locale). Lists en/ posts; drafts hidden in prod.
 * @file src/pages/blog/index.astro
 */
import Layout from '../../layouts/Layout.astro';
import BlogList from '../../components/BlogList.astro';
import LanguageAlternates from '../../components/LanguageAlternates.astro';
import BlogFeedLink from '../../components/BlogFeedLink.astro';
import { getCollection } from 'astro:content';
import { localizedPosts } from '../../utils/blog';
import { messages } from '../../i18n';
import { SITE_URL } from '../../data/profile';

const posts = localizedPosts(await getCollection('blog'), 'en');
const m = messages('en').blog.meta;
---

<Layout
  title={m.title}
  description={m.description}
  lang="en"
  canonicalUrl={`${SITE_URL}/blog`}
>
  <LanguageAlternates slot="head" currentLang="en" currentPath="/blog" />
  <BlogFeedLink slot="head" lang="en" />
  <BlogList lang="en" posts={posts} />
</Layout>
