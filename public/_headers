# Netlify response headers: the single source (netlify.toml has no [[headers]]).
# Cloudflare sits in front and honours these Cache-Control values.
# HTML keeps Netlify's default (public, max-age=0, must-revalidate).
# No `Link: rel=preload` header for the hero: the DPR-aware
# <link rel="preload" imagesrcset> in the HTML picks the right size; a fixed
# header double-downloaded it on high-DPR screens.

# ===========================================================
# Security, every response.
# CSP keeps 'unsafe-inline': @playform/compress rewrites inline scripts after
# any hash could be taken, components use inline style="" attributes, and
# Cloudflare Web Analytics needs an allowlist entry.
# frame-ancestors 'none' matches X-Frame-Options: DENY (the site is never framed).
# X-XSS-Protection is not sent: browsers removed the filter and the CSP covers it.
# ===========================================================
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-src 'self'; manifest-src 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# ===========================================================
# Caching
# ===========================================================

# Content-hashed by Vite.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, but replaced only under a new file name (generate-images / font swap).
/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be long-cached, or returning visitors keep
# an old worker (Cloudflare once served a days-old sw.js).
/sw.js
  Cache-Control: no-store
  Service-Worker-Allowed: /

/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/robots.txt
  Cache-Control: public, max-age=86400
